{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yulo-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // src/hasher.ts 用 node:crypto 的 scrypt 做密码哈希（原因见那个文件的注释：
  // WebCrypto 的 PBKDF2 要 40ms，超过免费套餐 10ms 的 CPU 上限）。
  // node:crypto 需要这个 flag。免费套餐同样支持 nodejs_compat。
  "compatibility_flags": ["nodejs_compat"],

  // 自定义域：绑定后 api.yulo.top 与站点 yulo.top 属于同一个可注册域，
  // 于是 HttpOnly Cookie 是「同站」的，SameSite=Lax 就能正常工作，
  // 不会被浏览器的第三方 Cookie 策略拦掉。
  // 前提：yulo.top 这个 zone 在同一个 Cloudflare 账号里（已确认 NS 指向 Cloudflare）。
  "routes": [{ "pattern": "api.yulo.top", "custom_domain": true }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yulo-chat",
      // 这个 id 是 `npx wrangler d1 create yulo-chat` 建出来的线上库。
      // 注意：Miniflare 的本地 D1 文件名按它派生，所以**改了这个 id，
      // 本地就要重新跑一次 `npm run migrate:local`**，否则本地库是空的，
      // 接口会全部 500 并报 `no such table`（线上不受影响）。
      "database_id": "29dab35b-2549-40f6-8430-d5b826093b05",
      "migrations_dir": "drizzle/migrations"
    }
  ],

  // 聊天室上传的图片和文档。单独开一个 bucket 而不是复用博客那个 `image`，
  // 因为这里的对象是「用户产生的内容」，将来要做清理策略（撤回、孤儿对象）会方便很多。
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "yulo-chat-media"
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "CHAT_ROOM", "class_name": "ChatRoom" }]
  },

  // 免费套餐只支持 SQLite 后端的 Durable Object，所以必须是 new_sqlite_classes。
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ],

  "vars": {
    // 允许跨域携带 Cookie 的来源白名单（逗号分隔）。localhost 是给 `hugo server` 本地预览用的。
    "ALLOWED_ORIGINS": "https://yulo.top,http://localhost:1313",
    // 媒体对象的公开访问前缀。走 R2 直连而不是 Worker 代理：
    // ① 不消耗 Worker 请求额度；② 视频拖进度条要的 HTTP Range 由 R2 原生支持。
    // 代价是这个域名下的对象**不需要登录就能访问**（UUID 文件名不可枚举）。
    // 想换成自定义域（如 media.yulo.top）时只改这一行 + 博客侧的 params.chat.mediaBase。
    "MEDIA_BASE_URL": "https://media.yulo.top"
  },

  "observability": {
    "enabled": true
  }

  // AUTH_SECRET 是机密，不要写在这里，用 `npx wrangler secret put AUTH_SECRET` 注入。
}
